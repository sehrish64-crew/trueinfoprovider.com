# Production environment variables example
# Copy this to .env.production.local or set these values in your hosting provider.

# MySQL database for production
# You can either use DATABASE_URL or the individual MYSQL_* variables.
DATABASE_URL="mysql://user:password@host:3306/database"
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""

# NextAuth settings
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://your-production-domain.com"

# Cloudflare R2 storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

# AI service URL (if hosted separately)
AI_SERVICE_URL=""
YOLO_MODEL_PATH=""

# Roboflow settings
ROBOFLOW_WORKSPACE_ID=""
ROBOFLOW_PROJECT=""
ROBOFLOW_MODEL_VERSION=""
ROBOFLOW_API_KEY=""
